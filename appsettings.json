{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=PersonalBlogDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Issuer": "PersonalBlogAPI",
    "Audience": "PersonalBlogClient",
    "ExpirationInMinutes": 60,
    "SecretKey": "ReplaceThisWithAComplexSecretKeyThatIsAtLeast32BytesLong"
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Personal Blog",
    "SenderEmail": "your-email@gmail.com",
    "Username": "your-email@gmail.com",
    "Password": "your-app-password"
  },
  "ClientSettings": {
    "Url": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
